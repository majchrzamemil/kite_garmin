<?xml version="1.0" encoding="UTF-8"?>
<!--
  FIT custom field contributions for the Kite Tracker app.

  These entries register the per-lap custom fields written from
  source/SessionManager.mc. Field IDs MUST match the constants
  SessionManager.FIELD_HEIGHT (0), FIELD_LENGTH (1), and
  FIELD_AIRTIME (2) and the string IDs must resolve to entries in
  resources/strings/strings.xml.

  The "displayInActivityLaps=true" flag tells Garmin Connect to show
  each value on the lap detail screen of the activity.
-->
<fitContributions>
    <fitField id="0"
              displayInActivityLaps="true"
              sortOrder="0"
              precision="1"
              dataLabel="@Strings.JumpHeightLabel"
              unitLabel="@Strings.MetersUnit" />
    <fitField id="1"
              displayInActivityLaps="true"
              sortOrder="1"
              precision="1"
              dataLabel="@Strings.JumpLengthLabel"
              unitLabel="@Strings.MetersUnit" />
    <fitField id="2"
              displayInActivityLaps="true"
              sortOrder="2"
              precision="1"
              dataLabel="@Strings.JumpAirtimeLabel"
              unitLabel="@Strings.SecondsUnit" />
    <!-- Record-level telemetry (ids 3/4): raw barometer and total-G per
         record, written from source/SessionManager.mc so false jumps
         can be replayed offline. Not shown in lap views. -->
    <fitField id="3"
              displayInActivityLaps="false"
              sortOrder="3"
              precision="0"
              dataLabel="@Strings.RawPressureLabel"
              unitLabel="@Strings.PascalUnit" />
    <fitField id="4"
              displayInActivityLaps="false"
              sortOrder="4"
              precision="2"
              dataLabel="@Strings.AccelGLabel"
              unitLabel="@Strings.GUnit" />
</fitContributions>
