<!--
  Manifest for the Kite Jump Tracker Garmin app.

  Target device: Instinct Solar 2 (part number "instinct2").
  App type: standalone Watch App with ActivityRecording permission so we can
  emit a FIT activity file at session end. The FIT file syncs to Garmin
  Connect, where each detected jump appears as one Lap with the jump's
  distance, elapsed_time, and a custom jump_height field.
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">

  <iq:application id="785338c3ba9644aeb158b2ccf7d3230e"
                  type="watch-app"
                  name="@Strings.AppName"
                  entry="App"
                  launcherIcon="@Drawables.LauncherIcon"
                  minApiLevel="3.0.0">

    <!-- Instinct Solar 2 -->
    <iq:products>
      <iq:product id="instinct2"/>
    </iq:products>

    <!-- Required permissions:
         - Sensor          : accelerometer
         - SensorHistory   : barometric pressure history
         - Positioning     : GPS for horizontal jump length
         - Fit             : emit a FIT activity file at session end
         - FitContributor  : helper API for writing FIT via the system
    -->
    <iq:permissions>
      <iq:uses-permission id="Sensor"/>
      <iq:uses-permission id="SensorHistory"/>
      <iq:uses-permission id="Positioning"/>
      <iq:uses-permission id="Fit"/>
      <iq:uses-permission id="FitContributor"/>
    </iq:permissions>

    <iq:languages>
      <iq:language>en-US</iq:language>
    </iq:languages>
  </iq:application>
</iq:manifest>
